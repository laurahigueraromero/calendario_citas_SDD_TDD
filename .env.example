# Copia este archivo a .env y ajusta lo que necesites.
# docker compose lo lee automáticamente. .env está en .gitignore.

# ---- MySQL ----
MYSQL_DATABASE=calendario
MYSQL_USER=calendario
MYSQL_PASSWORD=calendario
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# ---- MailHog ----
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ---- Backend (Spring Boot, ejecutándose en local) ----
# Perfil activo: local (compose) | docker (contenedor) | test (Testcontainers).
SPRING_PROFILES_ACTIVE=local
# Descomenta si cambias los valores por defecto de arriba.
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/calendario
# SPRING_DATASOURCE_USERNAME=calendario
# SPRING_DATASOURCE_PASSWORD=calendario
# SPRING_MAIL_HOST=localhost
# SPRING_MAIL_PORT=1025
# APP_TIMEZONE=Europe/Madrid

# ---- OAuth2: login con GitHub y Google ----
# GitHub  -> https://github.com/settings/developers  (New OAuth App)
#   Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google  -> https://console.cloud.google.com/apis/credentials  (OAuth client ID, Web application)
#   Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Si se dejan vacías, el backend arranca igual pero ese proveedor de login no funcionará.
